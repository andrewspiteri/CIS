{
  "stryker-config": {
    "test-projects": [
      "../../tests/Cis.Abstractions.Tests/Cis.Abstractions.Tests.csproj"
    ],
    "mutate": [
      "CisPathSafety.cs",
      "CisArchiveSafety.cs",
      "CisProcessSafety.cs"
    ],
    "configuration": "Release",
    "target-framework": "net10.0",
    "test-runner": "mtp",
    "coverage-analysis": "off",
    "concurrency": 1,
    "additional-timeout": 10000,
    "mutation-level": "Basic",
    "reporters": ["cleartext", "json"],
    "report-file-name": "cis-abstractions-hardening",
    "thresholds": {
      "high": 85,
      "low": 80,
      "break": 80
    }
  }
}
