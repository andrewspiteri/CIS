{
  "stryker-config": {
    "project": "Production.csproj",
    "test-projects": ["../Tests/Tests.csproj"],
    "mutate": ["PositivePolicy.cs"],
    "configuration": "Release",
    "target-framework": "net10.0",
    "test-runner": "vstest",
    "coverage-analysis": "off",
    "concurrency": 1,
    "disable-bail": false,
    "disable-mix-mutants": true,
    "additional-timeout": 15000,
    "break-on-initial-test-failure": true,
    "mutation-level": "Basic",
    "reporters": ["json", "cleartext"],
    "thresholds": {"break": 90, "low": 90, "high": 100},
    "test-case-filter": "FullyQualifiedName~CompatFixture.Tests.PolicyTests"
  }
}
